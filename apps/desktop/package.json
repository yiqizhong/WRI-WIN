{
  "name": "@writer/desktop",
  "version": "0.9.1",
  "description": "Writer — Figma UX Copy Review",
  "author": "Dell",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:renderer": "vite build",
    "build:daemon": "node scripts/build-daemon.mjs",
    "build:llama": "node scripts/build-llama.mjs",
    "build:app": "electron-builder --win --x64",
    "build": "npm run build:renderer && npm run build:daemon && npm run build:llama && npm run build:app"
  },
  "dependencies": {
    "@animateicons/react": "^0.3.3",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@writer/contracts": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "koffi": "^3.0.2",
    "lucide-react": "^0.561.0",
    "next-themes": "^0.4.6",
    "react-router-dom": "^7.15.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.7",
    "sass-embedded": "^1.100.0"
  }
}
